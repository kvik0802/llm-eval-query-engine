# LLM Judge & Pipeline providers (optional: auto-detects if available)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Judge selection (auto | openai | anthropic | gemini | ollama | heuristic)
JUDGE_PROVIDER=auto
JUDGE_MODEL=

# Pipeline execution mode (rules | llm)
PIPELINE_MODE=rules
# Variant under test (good | poor)
PIPELINE_VARIANT=good

# Worker concurrency
EVAL_WORKERS=4
